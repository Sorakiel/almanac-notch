{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almanac Notch Setup",
  "version": "../desktop/package.json",
  "identifier": "dev.almanac.notch.setup",
  "build": {
    "frontendDist": "../desktop/dist/setup"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../desktop/src-tauri/icons/32x32.png",
      "../desktop/src-tauri/icons/128x128.png",
      "../desktop/src-tauri/icons/icon.icns",
      "../desktop/src-tauri/icons/icon.ico"
    ]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Island window: events from the core and stub commands",
  "windows": ["island"],
  "permissions": [
    "core:event:default",
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all"
  ]
}
